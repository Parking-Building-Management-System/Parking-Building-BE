meta {
  name: Approve Violation Report
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/staff/violation-reports/{{violationReportId}}/approve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffExitToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "confirmedOffenderPlateNumber": "51A-99999",
    "note": "Vehicle verified in the reported slot."
  }
}
